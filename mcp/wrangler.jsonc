{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "design-docs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Everything but the MCP endpoint is served straight from the asset cache
    "run_worker_first": ["/mcp", "/mcp/*"],
  },
  "observability": {
    "enabled": true,
  },
}
