{
  "name": "stihl-design-system-figma-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Extracts Design System documentation from Figma into Markdown (DS-1524 spike)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "sync": "tsx src/cli/sync.ts",
    "check": "tsx src/cli/checkVersion.ts",
    "fetch:fixture": "tsx src/cli/fetchFixture.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@figma/rest-api-spec": "^0.33.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "yaml": "^2.8.0"
  }
}
